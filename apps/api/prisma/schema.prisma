// FlowTrade data model — Prisma 7, PostgreSQL.
// Every table lives in the schema named by DB_SCHEMA (default "flowtrade"); see prisma.config.ts.
// Field names mirror packages/shared/src/types.ts so API responses map 1:1 to the frontend types.
// Constraints Prisma cannot express (CHECKs, case-insensitive uniques) are added in the migration SQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum Channel {
  OFFLINE
  ONLINE
}

enum ProposalStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EntityType {
  PROPOSAL
  TASK
  STORE
  SHELF_TYPE
  PRODUCT
  USER
  TEMPLATE
  DEPARTMENT
  MANUFACTURER
}

enum DescriptionFormat {
  TEXT
  FIELDS
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  PROPOSAL_STATUS
  COMMENT
  /// Someone else's logged movement (ActivityService.log fan-out): ADMIN / MANAGER see all, assignees their tasks'.
  ACTIVITY
}

/// Where a store's buyer presentation stands (cached on presentation_tracks; the events decide).
enum PresentationStage {
  AWAITING
  IN_REVIEW
  NEEDS_INFO
  PASSED
  REJECTED
  WITHDRAWN
}

enum PresentationEventKind {
  CREATED
  SCHEDULED
  PRESENTED
  NEEDS_INFO
  INFO_SENT
  PASSED
  REJECTED
  WITHDRAWN
  REPITCH
  REVERTED
  EDITED
}

enum RejectReason {
  PRICE
  DUPLICATE
  CATEGORY_FIT
  SHELF_SPACE
  DOCUMENTS
  OTHER
}

/// Where one SKU of a proposal stands in production ("รอผลิต"). PENDING = not confirmed yet (a row only keeps the
/// quantity of a confirm that was stepped back; quantities are entered at confirm).
enum ProductionStatus {
  PENDING
  IN_PRODUCTION
  PRODUCED
  DELIVERED
  CANCELLED
}

enum ProductionEventKind {
  QUANTITY
  PLAN
  CONFIRM
  ADVANCE
  BACK
  DATES
  CANCEL
  RESTORE
  KEEP
  ORDER
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Optional, stored lower-case. A user needs an email or a username (CHECK in migration).
  email              String?   @unique
  /// Short sign-in name (stored lower-case), e.g. "admin". Login accepts email or username.
  username           String?   @unique
  name               String
  nickname           String?
  /// One of the admin-managed department names (FK on departments.name, renames cascade).
  department         String?
  position           String?
  role               Role      @default(USER)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  passwordHash       String    @map("password_hash")
  avatarColor        String    @default("#2563eb") @map("avatar_color")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  departmentRef             Department?              @relation(fields: [department], references: [name], onDelete: Restrict, onUpdate: Cascade)
  sessions                  Session[]
  ownedProposals            Proposal[]               @relation("ProposalOwner")
  memberships               ProposalMember[]
  assignments               TaskAssignee[]
  createdTasks              Task[]                   @relation("TaskCreatedBy")
  completedTasks            Task[]                   @relation("TaskCompletedBy")
  comments                  Comment[]
  activity                  ActivityLog[]
  notifications             Notification[]
  presentationPackages      PresentationPackage[]
  presentationEvents        PresentationEvent[]
  productionPlans           ProductionPlan[]         @relation("ProductionPlanUpdatedBy")
  productionConfirmed       ProductionItem[]         @relation("ProductionItemConfirmedBy")
  productionProduced        ProductionItem[]         @relation("ProductionItemProducedBy")
  productionDelivered       ProductionItem[]         @relation("ProductionItemDeliveredBy")
  productionCancelled       ProductionItem[]         @relation("ProductionItemCancelledBy")
  productionKept            ProductionItem[]         @relation("ProductionItemKeptBy")
  productionEvents          ProductionEvent[]        @relation("ProductionEventActor")
  productionOrdersMain      ProductionOrder[]        @relation("ProductionOrderMainContact")
  productionOrdersConfirmed ProductionOrder[]        @relation("ProductionOrderConfirmedBy")
  productionOrderContacts   ProductionOrderContact[]

  @@map("users")
}

/// Company departments — the only values allowed for users.department (admins manage the list).
model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]

  @@map("departments")
}

/// Server-side session; only the SHA-256 hash of the cookie token is stored.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  ip                String?
  userAgent         String?   @map("user_agent")
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Retailer (offline) or marketplace/platform (online).
model Store {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  shortName   String   @map("short_name")
  channel     Channel
  color       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposals          ProposalStore[]
  templates          TaskTemplate[]
  presentationTracks PresentationTrack[]

  @@index([channel, sortOrder])
  @@map("stores")
}

/// Shelf type (offline) or listing type (online).
model ShelfType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  channel     Channel
  color       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposals Proposal[]
  templates TaskTemplate[]

  @@index([channel, sortOrder])
  @@map("shelf_types")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  /// Stored upper-case.
  sku       String   @unique
  name      String
  brand     String
  category  String
  barcode   String?
  size      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposals       ProposalProduct[]
  productionItems ProductionItem[]

  @@map("products")
}

/// Companies that produce our SKUs ("บริษัทรับผลิต") — picked on every production order (admins manage the list).
model Manufacturer {
  id        String   @id @default(uuid()) @db.Uuid
  /// Unique ignoring case and never blank (index / CHECK in migration).
  name      String
  /// Optional address / phone / remark.
  note      String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders ProductionOrder[]

  @@map("manufacturers")
}

/// One listing project: products → one or more stores (one shared task list) → one shelf type → target on-shelf date.
model Proposal {
  id          String         @id @default(uuid()) @db.Uuid
  /// PRJ-<year>-<0001>, generated from proposal_counters.
  code        String         @unique
  title       String
  channel     Channel
  shelfTypeId String         @map("shelf_type_id") @db.Uuid
  /// Business date (Asia/Bangkok).
  targetDate  DateTime       @map("target_date") @db.Date
  status      ProposalStatus @default(IN_PROGRESS)
  ownerId     String         @map("owner_id") @db.Uuid
  templateId  String?        @map("template_id") @db.Uuid
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt DateTime?      @map("completed_at") @db.Timestamptz(3)

  shelfType            ShelfType             @relation(fields: [shelfTypeId], references: [id], onDelete: Restrict)
  owner                User                  @relation("ProposalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  template             TaskTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  stores               ProposalStore[]
  members              ProposalMember[]
  products             ProposalProduct[]
  tasks                Task[]
  comments             Comment[]
  activity             ActivityLog[]
  presentationPackages PresentationPackage[]
  presentationTracks   PresentationTrack[]
  productionPlan       ProductionPlan?
  productionItems      ProductionItem[]
  productionEvents     ProductionEvent[]
  productionOrders     ProductionOrder[]

  @@index([status, targetDate])
  @@index([ownerId])
  @@map("proposals")
}

/// The stores a proposal is listed at (at least one; only ADMIN can change them after creation).
model ProposalStore {
  proposalId String @map("proposal_id") @db.Uuid
  storeId    String @map("store_id") @db.Uuid

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@id([proposalId, storeId])
  @@index([storeId])
  @@map("proposal_stores")
}

model ProposalMember {
  proposalId String   @map("proposal_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([proposalId, userId])
  @@index([userId])
  @@map("proposal_members")
}

model ProposalProduct {
  proposalId String @map("proposal_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  sortOrder  Int    @default(0) @map("sort_order")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([proposalId, productId])
  @@index([productId])
  @@map("proposal_products")
}

/// Per-year running number for proposal codes (row-locked increment).
model ProposalCounter {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("proposal_counters")
}

/// Task / Sub task / Mini task — adjacency list, max depth 3 (CHECK in migration).
model Task {
  id                String            @id @default(uuid()) @db.Uuid
  proposalId        String            @map("proposal_id") @db.Uuid
  parentId          String?           @map("parent_id") @db.Uuid
  level             Int               @db.SmallInt
  title             String
  description       String?
  /// TEXT = details are `description`; FIELDS = details are the `detailFields` rows.
  descriptionFormat DescriptionFormat @default(TEXT) @map("description_format")
  /// [{ id, label, value }] — label → value rows (FIELDS format), [] otherwise.
  detailFields      Json              @default("[]") @map("detail_fields")
  startDate         DateTime?         @map("start_date") @db.Date
  dueDate           DateTime?         @map("due_date") @db.Date
  /// Responsible department / team, e.g. "NPD" (free text).
  responsible       String?
  priority          TaskPriority      @default(MEDIUM)
  isDone            Boolean           @default(false) @map("is_done")
  completedAt       DateTime?         @map("completed_at") @db.Timestamptz(3)
  completedById     String?           @map("completed_by_id") @db.Uuid
  sortOrder         Int               @default(0) @map("sort_order")
  createdById       String            @map("created_by_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposal    Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  parent      Task?          @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]         @relation("TaskTree")
  completedBy User?          @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdBy   User           @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignees   TaskAssignee[]
  comments    Comment[]

  @@index([proposalId, parentId, sortOrder])
  @@index([isDone, dueDate])
  @@map("tasks")
}

model TaskAssignee {
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  /// null = every channel (offline and online).
  channel     Channel?
  /// null = every shelf type of the channel.
  shelfTypeId String?  @map("shelf_type_id") @db.Uuid
  /// null = every store of the channel.
  storeId     String?  @map("store_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shelfType ShelfType?         @relation(fields: [shelfTypeId], references: [id], onDelete: SetNull)
  store     Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items     TaskTemplateItem[]
  proposals Proposal[]

  @@map("task_templates")
}

model TaskTemplateItem {
  id              String  @id @default(uuid()) @db.Uuid
  templateId      String  @map("template_id") @db.Uuid
  parentId        String? @map("parent_id") @db.Uuid
  level           Int     @db.SmallInt
  title           String
  /// Days relative to the proposal's target date (negative = before launch).
  startOffsetDays Int     @map("start_offset_days")
  dueOffsetDays   Int     @map("due_offset_days")
  responsible     String?
  /// ["label", …] — when non-empty the task starts in FIELDS format with these rows (values empty).
  fieldLabels     Json    @default("[]") @map("field_labels")
  sortOrder       Int     @default(0) @map("sort_order")

  template TaskTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parent   TaskTemplateItem?  @relation("TemplateTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TaskTemplateItem[] @relation("TemplateTree")

  @@index([templateId, sortOrder])
  @@map("task_template_items")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  proposalId String   @map("proposal_id") @db.Uuid
  taskId     String?  @map("task_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([proposalId])
  @@map("comments")
}

/// Append-only audit trail.
model ActivityLog {
  id         String     @id @default(uuid()) @db.Uuid
  actorId    String     @map("actor_id") @db.Uuid
  action     String
  entityType EntityType @map("entity_type")
  /// Not a foreign key: the entity may have been deleted.
  entityId   String     @map("entity_id")
  proposalId String?    @map("proposal_id") @db.Uuid
  summary    String
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  actor    User      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([proposalId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

/// "ชุดนำเสนอ #seq": the finished prep tasks bundled for buyer presentations at one or more stores.
model PresentationPackage {
  id          String   @id @default(uuid()) @db.Uuid
  proposalId  String   @map("proposal_id") @db.Uuid
  /// 1, 2, … per proposal; next = max(seq) + 1.
  seq         Int
  note        String?
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  proposal  Proposal                  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdBy User                      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tasks     PresentationPackageTask[]
  tracks    PresentationTrack[]

  @@unique([proposalId, seq])
  @@map("presentation_packages")
}

/// One bundled level-1 task, frozen when the package was made.
model PresentationPackageTask {
  id           String    @id @default(uuid()) @db.Uuid
  packageId    String    @map("package_id") @db.Uuid
  /// Not a foreign key: the task may be deleted later and the web flags it by this id.
  taskId       String    @map("task_id") @db.Uuid
  title        String
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)
  /// detailFieldsProgress().filled / .total; 0 / 0 for TEXT tasks.
  fieldsFilled Int       @default(0) @map("fields_filled")
  fieldsTotal  Int       @default(0) @map("fields_total")
  sortOrder    Int       @default(0) @map("sort_order")

  package PresentationPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, taskId])
  @@map("presentation_package_tasks")
}

/// One store's presentation of a proposal (one per store, ever). The events are the truth; stage/round are a cache.
model PresentationTrack {
  id             String            @id @default(uuid()) @db.Uuid
  proposalId     String            @map("proposal_id") @db.Uuid
  packageId      String            @map("package_id") @db.Uuid
  storeId        String            @map("store_id") @db.Uuid
  /// Store look frozen on creation, so a store later removed from the proposal still renders.
  storeName      String            @map("store_name")
  storeShortName String            @map("store_short_name")
  storeColor     String            @map("store_color")
  /// reduceTrack(...).stage / .round after the latest write.
  stage          PresentationStage @default(AWAITING)
  round          Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposal Proposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  package  PresentationPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  store    Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  events   PresentationEvent[]

  @@unique([proposalId, storeId])
  @@index([packageId])
  @@index([storeId])
  @@map("presentation_tracks")
}

/// Append-only track history; `seq` (1, 2, … per track) is the order. Values are as recorded — EDITED / REVERTED
/// events change the effective ones (reduceTrack).
model PresentationEvent {
  id            String                @id @default(uuid()) @db.Uuid
  trackId       String                @map("track_id") @db.Uuid
  seq           Int
  kind          PresentationEventKind
  actorId       String                @map("actor_id") @db.Uuid
  recordedAt    DateTime              @default(now()) @map("recorded_at") @db.Timestamptz(3)
  /// Business date of PRESENTED, NEEDS_INFO, INFO_SENT, PASSED, REJECTED and WITHDRAWN (null for the others).
  date          DateTime?             @db.Date
  /// REJECTED only.
  rejectReason  RejectReason?         @map("reject_reason")
  /// REVERTED / EDITED only: the event they correct (same track).
  targetEventId String?               @map("target_event_id") @db.Uuid
  /// The kind's other fields (StageEvent / MetaEvent minus kind, date, REJECTED.reason and targetEventId).
  payload       Json                  @default("{}")

  track       PresentationTrack   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  actor       User                @relation(fields: [actorId], references: [id], onDelete: Restrict)
  target      PresentationEvent?  @relation("PresentationEventTarget", fields: [targetEventId], references: [id], onDelete: Cascade)
  corrections PresentationEvent[] @relation("PresentationEventTarget")

  @@unique([trackId, seq])
  @@index([targetEventId])
  @@map("presentation_events")
}

/// Production settings of one proposal; created on the first change (no row = defaults: 14 days, no note).
model ProductionPlan {
  proposalId  String   @id @map("proposal_id") @db.Uuid
  /// Deadline = proposals.target_date − lead_days (0–90, CHECK in migration).
  leadDays    Int      @default(14) @map("lead_days")
  note        String?
  updatedById String   @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposal  Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  updatedBy User     @relation("ProductionPlanUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("production_plans")
}

/// One SKU of a proposal in production; created at a skip or at confirmation. Kept quantities and skips of SKUs
/// removed from the proposal are deleted with that edit; confirmed rows only with the proposal (or its delete).
model ProductionItem {
  id            String           @id @default(uuid()) @db.Uuid
  proposalId    String           @map("proposal_id") @db.Uuid
  productId     String           @map("product_id") @db.Uuid
  /// Pieces, 1–1,000,000; null only while PENDING or skipped (CANCELLED, never confirmed).
  quantity      Int?
  status        ProductionStatus @default(PENDING)
  /// The real press of "ยืนยันเริ่มผลิต" (who / when).
  confirmedAt   DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  confirmedById String?          @map("confirmed_by_id") @db.Uuid
  /// Business date (Asia/Bangkok) production starts: its order's "วันที่ดำเนินการ" (may be after today); rows confirmed
  /// before order schedules existed: the earliest pass of the confirmed set (older rows: a picked date).
  startedOn     DateTime?        @map("started_on") @db.Date
  /// "วันที่ต้องการสินค้า" picked at confirm: this SKU's delivery due date; null = the plan deadline (rows confirmed before it existed).
  neededOn      DateTime?        @map("needed_on") @db.Date
  /// The "ใบสั่งผลิต" of the press that confirmed it; null = never confirmed, or confirmed before orders existed (CHECK in migration).
  orderId       String?          @map("order_id") @db.Uuid
  producedOn    DateTime?        @map("produced_on") @db.Date
  producedById  String?          @map("produced_by_id") @db.Uuid
  deliveredOn   DateTime?        @map("delivered_on") @db.Date
  deliveredById String?          @map("delivered_by_id") @db.Uuid
  /// The deadline when it was delivered (frozen), so later lead-day / launch changes do not re-grade it.
  dueOn         DateTime?        @map("due_on") @db.Date
  cancelledAt   DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?          @map("cancelled_by_id") @db.Uuid
  cancelReason  String?          @map("cancel_reason")
  /// Who / when last acknowledged a change of the passing stores ("ผลิตต่อ" / "จำนวนเดิมใช้ได้").
  keptAt        DateTime?        @map("kept_at") @db.Timestamptz(3)
  keptById      String?          @map("kept_by_id") @db.Uuid
  /// Passing stores the confirmed quantity was decided for; a different current set raises a review.
  ackStoreIds   String[]         @default([]) @map("ack_store_ids") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposal    Proposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  confirmedBy User?             @relation("ProductionItemConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  producedBy  User?             @relation("ProductionItemProducedBy", fields: [producedById], references: [id], onDelete: Restrict)
  deliveredBy User?             @relation("ProductionItemDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  cancelledBy User?             @relation("ProductionItemCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  keptBy      User?             @relation("ProductionItemKeptBy", fields: [keptById], references: [id], onDelete: Restrict)
  /// NO ACTION (checked at statement end), so a proposal delete that cascades to both items and orders works.
  order       ProductionOrder?  @relation(fields: [orderId], references: [id], onDelete: NoAction)
  events      ProductionEvent[]

  @@unique([proposalId, productId])
  @@index([productId])
  @@index([orderId])
  @@map("production_items")
}

/// "ใบสั่งผลิต": one per press of "ยืนยันเริ่มผลิต", covering every SKU confirmed by it (production_items.order_id). An
/// order left without items (stepped back to PENDING) is deleted; the owner / a manager may edit it any time.
model ProductionOrder {
  id             String    @id @default(uuid()) @db.Uuid
  proposalId     String    @map("proposal_id") @db.Uuid
  /// 1, 2, … per proposal ("ใบสั่งผลิตที่ n"), never reused: next = 1 + the highest number the proposal's orders and
  /// production events (detail orderSeq) carry, under the proposal lock.
  seq            Int
  /// "รหัสเอกสารอ้างอิง" (e.g. a PO / PR number), trimmed; null = none, never blank (CHECK in migration).
  referenceNo    String?   @map("reference_no")
  manufacturerId String    @map("manufacturer_id") @db.Uuid
  /// "ผู้ติดต่อหลัก" (an internal user); never also listed as a co-contact (the service keeps them apart).
  mainContactId  String    @map("main_contact_id") @db.Uuid
  /// The press that created it (its items carry the same confirmedAt / confirmedById).
  confirmedAt    DateTime  @map("confirmed_at") @db.Timestamptz(3)
  confirmedById  String    @map("confirmed_by_id") @db.Uuid
  /// "วันที่ดำเนินการ" = production start (business date), also the startedOn of every item carrying the order. With
  /// productionDays both set or both null (orders confirmed before it existed); CHECKs in migration.
  startedOn      DateTime? @map("started_on") @db.Date
  /// "ระยะเวลาผลิตทั้งหมด (ประมาณ)", 1–365 days; expected arrival = startedOn + productionDays (never stored).
  productionDays Int?      @map("production_days")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Touched by every edit: the stale guard of PATCH …/production/orders/:orderId.
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposal     Proposal                 @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  manufacturer Manufacturer             @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  mainContact  User                     @relation("ProductionOrderMainContact", fields: [mainContactId], references: [id], onDelete: Restrict)
  confirmedBy  User                     @relation("ProductionOrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  contacts     ProductionOrderContact[]
  items        ProductionItem[]

  @@unique([proposalId, seq])
  @@index([manufacturerId])
  @@index([mainContactId])
  @@map("production_orders")
}

/// "ผู้ติดต่อร่วม" of a production order (internal users; the main contact is never listed here).
model ProductionOrderContact {
  orderId String   @map("order_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([orderId, userId])
  @@index([userId])
  @@map("production_order_contacts")
}

/// Append-only production log of a proposal; item_id is null only for PLAN.
model ProductionEvent {
  id             String              @id @default(uuid()) @db.Uuid
  proposalId     String              @map("proposal_id") @db.Uuid
  itemId         String?             @map("item_id") @db.Uuid
  kind           ProductionEventKind
  actorId        String              @map("actor_id") @db.Uuid
  recordedAt     DateTime            @default(now()) @map("recorded_at") @db.Timestamptz(3)
  fromStatus     ProductionStatus?   @map("from_status")
  toStatus       ProductionStatus?   @map("to_status")
  /// Business date of the step: CONFIRM = start day, ADVANCE = produced / delivered date, BACK = the date it cleared.
  date           DateTime?           @db.Date
  quantityBefore Int?                @map("quantity_before")
  quantityAfter  Int?                @map("quantity_after")
  leadDaysBefore Int?                @map("lead_days_before")
  leadDaysAfter  Int?                @map("lead_days_after")
  /// CANCEL reason.
  reason         String?
  /// DATES: { neededOn? | producedOn? | deliveredOn?: [before, after] }; CONFIRM: { neededOn, orderId?, orderSeq?,
  /// manufacturerName?, referenceNo? }; ORDER (an order edit, one per item of it): { orderId, orderSeq, referenceNo? |
  /// manufacturer? | mainContactId?: [before, after], coContacts?: { added, removed } }; PLAN: { noteChanged }; KEEP: { storeIds }; else {}.
  detail         Json                @default("{}")

  proposal Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  item     ProductionItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor    User            @relation("ProductionEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([proposalId, recordedAt(sort: Desc)])
  @@index([itemId])
  @@map("production_events")
}
